# 1. Désactiver complètement le moteur PHP pour ce dossier
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 2. Forcer les fichiers à être traités comme du texte brut au cas où
RemoveHandler .phtml .php .php3 .php4 .php5 .php6 .phps .cgi .exe .pl .asp .aspx .shtml .shtm .fcgi .fpl .jsp .htm .html .wml
AddType application/x-httpd-php-source .php .phtml

# 3. Interdire purement et simplement la lecture HTTP des scripts et des HTML
<FilesMatch "(?i)\.(php|php[3-8]|phtml|pl|py|jsp|asp|sh|cgi|html|htm)$">
    Require all denied
</FilesMatch>
